      "post": {"summary": "Clear embeddings for backfill", "responses": {"200": {"description": "ok"}}, "security": [{"bearer": []}]}
    },
    "/admin/spaces/{space}/acl": {
      "post": {"summary": "Replace a space ACL", "responses": {"200": {"description": "ok"}}, "security": [{"bearer": []}]}
    },
    "/admin/spaces/{space}/lock": {
      "post": {"summary": "Lock a space read-only", "responses": {"200": {"description": "ok"}}, "security": [{"bearer": []}]}
    },
    "/admin/stats": {
      "get": {"summary": "Volume for a space or the instance", "responses": {"200": {"description": "ok"}}, "security": [{"bearer": []}]}
    },
    "/admin/telemetry": {
      "get": {"summary": "Read-only dashboard aggregates (admin key)", "responses": {"200": {"description": "ok"}}, "security": [{"bearer": []}]}
    },
    "/assets/": {
      "get": {"summary": "MEMEX website assets", "responses": {"200": {"description": "ok"}}, "security": [{"bearer": []}]}
    },
    "/dash": {
      "get": {"summary": "MEMEX dashboard (admin UI, mxa_ key)", "responses": {"200": {"description": "ok"}}, "security": [{"bearer": []}]}
    },
    "/healthz": {
      "get": {"summary": "Process health", "responses": {"200": {"description": "ok"}}},
      "get": {"summary": "Admin listener health", "responses": {"200": {"description": "ok"}}}
