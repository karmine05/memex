      "get": {"summary": "Full hash chain and readers", "responses": {"200": {"description": "ok"}}, "security": [{"bearer": []}]}
    },
    "/admin/notes/{id}/diff": {
      "get": {"summary": "Diff two versions", "responses": {"200": {"description": "ok"}}, "security": [{"bearer": []}]}
    },
    "/admin/notes/{id}/readers": {
      "get": {"summary": "Who read the note", "responses": {"200": {"description": "ok"}}, "security": [{"bearer": []}]}
    },
    "/admin/notes/{id}/versions": {
      "get": {"summary": "Version list", "responses": {"200": {"description": "ok"}}, "security": [{"bearer": []}]}
    },
    "/admin/orphans": {
      "get": {"summary": "Notes with no reads and no refs", "responses": {"200": {"description": "ok"}}, "security": [{"bearer": []}]}
    },
