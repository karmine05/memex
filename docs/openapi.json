{
  "openapi": "3.0.3",
  "info": {"title": "memex", "version": "1.0.0"},
  "components": {"securitySchemes": {"bearer": {"type": "http", "scheme": "bearer"}}},
  "paths": {
    "/": {
      "get": {"summary": "MEMEX landing page", "responses": {"200": {"description": "ok"}}, "security": [{"bearer": []}]}
    },
    "/admin/agents": {
      "get": {"summary": "List agents", "responses": {"200": {"description": "ok"}}, "security": [{"bearer": []}]},
      "post": {"summary": "Issue an agent API key", "responses": {"200": {"description": "ok"}}, "security": [{"bearer": []}]}
    },
    "/admin/agents/{id}/quota": {
      "put": {"summary": "Set per-agent quota", "responses": {"200": {"description": "ok"}}, "security": [{"bearer": []}]}
    },
    "/admin/agents/{id}/resume": {
      "post": {"summary": "Resume a suspended agent", "responses": {"200": {"description": "ok"}}, "security": [{"bearer": []}]}
    },
    "/admin/agents/{id}/revoke": {
      "post": {"summary": "Revoke an agent", "responses": {"200": {"description": "ok"}}, "security": [{"bearer": []}]}
    },
    "/admin/agents/{id}/rotate": {
      "post": {"summary": "Issue a replacement API key; old key and live tokens die", "responses": {"200": {"description": "ok"}}, "security": [{"bearer": []}]}
    },
